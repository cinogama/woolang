/*                                       */

func test()
{
    using fsys;

    let current_work_path = workpath();

    // To make test_compile happy, we need to set workpath
    // to make sure pkg::std can be imported.
    do fsys::setworkpath(parent(normalize(__FILE__!)));
    defer do setworkpath(current_work_path);

    std::println("Unit-test begin!");

    std::sleep(1.);

    execute_all_test();
}

/*                                       */

test();
