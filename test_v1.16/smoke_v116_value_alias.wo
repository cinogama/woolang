import pkg::std;
import smoke_v116_tool;

/* Value aliases (dev_1.16): `alias Name<...> = <value-name>;` introduces
   another name for a function or variable. The alias always points at the
   symbol itself, never at a concrete generic instance; template arguments
   written at the use site belong to the target (or instantiate the alias
   itself when the alias is a template). */

namespace smoke_v116_value_alias
{
    func identity<T>(x: T)=> T
    {
        return x;
    }
    func add(a: int, b: int)=> int
    {
        return a + b;
    }

    type Ship: int
    {
        pub func label()=> string
        {
            return "ship";
        }
        pub func produce<U>(x: U)=> U
        {
            return x;
        }
    }

    type Holder<T>: struct
    {
        pub f: (T) => T,
        pub v: T,
    };

    // `f` is used with an `int`: an argument that aliases a generic function
    // gets its parameter from the parameter type.
    func apply_one(f: (int) => int, v: int)=> int
    {
        return f(v);
    }

    // `T` appears in both `v` and `f`, so deduction also reads the other
    // argument.
    func pick_first<T>(v: T, f: (T) => T)=> T
    {
        return f(v);
    }

    let mut counter = 0;

    // Alias to a non-generic function and to a generic one.
    alias plus = add;
    alias id = identity;

    // The target may be named through its type.
    alias ship_label = typeof<Ship>::label;

    // An alias of a global variable is the same storage.
    alias count = counter;

    // Template aliases compute a name from a type.
    alias label_of<T> = typeof<T>::label;
    alias label_of_alt<T> = typeof:<T>::label;
    alias produce_of<T> = typeof<T>::produce;
    alias label_const<T, N: int> = typeof<T>::label;

    // Template alias naming another template alias.
    alias inner<T> = typeof<T>::label;
    alias outer<T> = inner:<T>;

    // Forward alias chain: forward_b is declared after forward_a.
    alias forward_a = forward_b;
    alias forward_b = identity;

    func test_basic()
    {
        test_equal(plus(2, 3), 5);
        test_equal(ship_label(), "ship");

        let mut x = 1;
        alias y = x;
        test_equal(y, 1);
        y = 2;
        test_equal(x, 2);
    }

    func test_global_variable()
    {
        test_equal(count, 0);
        count = 7;
        test_equal(counter, 7);
        counter = 9;
        test_equal(count, 9);
    }

    func test_generic_target()
    {
        // Deduction runs on the target symbol, not on the alias.
        test_equal(id(3), 3);
        // Written arguments specialize the target as if its name was used.
        test_equal(id:<int>(4), 4);

        alias id2 = id;
        test_equal(id2(5), 5);
    }

    func test_argument_position()
    {
        // An alias passed as an argument is deduced like the target name.
        test_equal(apply_one(id, 3), 3);
        test_equal(pick_first(3, id), 3);
        test_equal(pick_first("s", id), "s");

        // A template alias is instantiated first; the parameter still
        // pending on its target is then deduced the same way.
        test_equal(apply_one(produce_of:<Ship>, 4), 4);
        test_equal(pick_first(5, produce_of:<Ship>), 5);
    }

    func test_struct_member()
    {
        // The same deduction for the value of a struct literal member.
        let holder = Holder:<int>{ f = id, v = 3 };
        test_equal(holder.f(holder.v), 3);
    }

    func test_template_alias()
    {
        test_equal(label_of:<Ship>(), "ship");
        test_equal(label_of_alt:<Ship>(), "ship");
        test_equal(label_const:<Ship, {0}>(), "ship");
        test_equal(produce_of:<Ship>(7), 7);
    }

    func test_chains()
    {
        test_equal(outer:<Ship>(), "ship");
        test_equal(forward_a(6), 6);

        // A use site may precede the alias declaration.
        test_equal(later:<int>(8), 8);
    }

    func main()
    {
        test_basic();
        test_global_variable();
        test_generic_target();
        test_argument_position();
        test_struct_member();
        test_template_alias();
        test_chains();
    }

    // Declared after its use site in test_chains.
    alias later = identity;
}

test_function("smoke_v116_value_alias.main", smoke_v116_value_alias::main);
